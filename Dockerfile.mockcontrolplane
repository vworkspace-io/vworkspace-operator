# Build the mock control plane agent API binary for in-cluster e2e tests.
FROM golang:1.25 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download
COPY . .

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o mockcontrolplane ./test/mockcontrolplane/cmd/mockcontrolplane

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/mockcontrolplane /mockcontrolplane
USER 65532:65532
ENTRYPOINT ["/mockcontrolplane"]
